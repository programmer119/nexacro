this.fnProcessLegacyData = function()
{
  // 원천 데이터 수집 후 화면용 데이터로 정제/집계/판정하는 처리 로직 예시입니다.
  var rawCount = 0;
  for (var i = 0; i < this.dsLegacyRaw.getRowCount(); i++) {
    rawCount++;
  }

  var equipmentCount = this.dsEquipment.getRowCount();
  var alarmCount = 0;
  for (var j = 0; j < equipmentCount; j++) {
    var runRate = nexacro.toNumber(this.dsEquipment.getColumn(j, "runRate"));
    var state = this.dsEquipment.getColumn(j, "state");
    if (runRate < 80 || state != "정상") {
      alarmCount++;
    }
  }

  this.dsProcessResult.clearData();
  var row = this.dsProcessResult.addRow();
  this.dsProcessResult.setColumn(row, "stepName", "원천 수집");
  this.dsProcessResult.setColumn(row, "inputCount", rawCount);
  this.dsProcessResult.setColumn(row, "outputCount", rawCount);
  this.dsProcessResult.setColumn(row, "result", "정상");
  this.dsProcessResult.setColumn(row, "remark", "MES/ERP/설비 Gateway 수집");

  row = this.dsProcessResult.addRow();
  this.dsProcessResult.setColumn(row, "stepName", "데이터 정제");
  this.dsProcessResult.setColumn(row, "inputCount", rawCount);
  this.dsProcessResult.setColumn(row, "outputCount", equipmentCount);
  this.dsProcessResult.setColumn(row, "result", "정상");
  this.dsProcessResult.setColumn(row, "remark", "설비별 최신값 기준 병합");

  row = this.dsProcessResult.addRow();
  this.dsProcessResult.setColumn(row, "stepName", "임계치 판정");
  this.dsProcessResult.setColumn(row, "inputCount", equipmentCount);
  this.dsProcessResult.setColumn(row, "outputCount", alarmCount);
  this.dsProcessResult.setColumn(row, "result", alarmCount > 0 ? "주의" : "정상");
  this.dsProcessResult.setColumn(row, "remark", "가동률 80% 미만 또는 상태 이상");
};

this.fnApplyFilter = function()
{
  var filter = "";
  if (this.cboPlant.value != "ALL") {
    filter += "plant == '" + this.cboPlant.value + "'";
  }
  if (this.cboLine.value != "ALL") {
    if (filter.length > 0) filter += " && ";
    filter += "line == '" + this.cboLine.value + "'";
  }
  if (this.cboState.value != "ALL") {
    if (filter.length > 0) filter += " && ";
    filter += "state == '" + this.cboState.value + "'";
  }
  this.dsEquipment.filter(filter);
};

this.fnCalculateKpi = function()
{
  var count = this.dsEquipment.getRowCount();
  var runSum = 0;
  var outputSum = 0;
  var defectSum = 0;
  var alarmCount = 0;

  for (var i = 0; i < count; i++) {
    runSum += nexacro.toNumber(this.dsEquipment.getColumn(i, "runRate"));
    outputSum += nexacro.toNumber(this.dsEquipment.getColumn(i, "output"));
    defectSum += nexacro.toNumber(this.dsEquipment.getColumn(i, "defect"));
    if (this.dsEquipment.getColumn(i, "state") != "정상") {
      alarmCount++;
    }
  }

  var runRate = count == 0 ? 0 : Math.round((runSum / count) * 10) / 10;
  var defectRate = outputSum == 0 ? 0 : Math.round((defectSum / outputSum * 100) * 100) / 100;
  this.staRunRateValue.set_text(runRate + "%");
  this.staOutputValue.set_text(outputSum);
  this.staDefectValue.set_text(defectRate + "%");
  this.staAlarmValue.set_text(alarmCount);
};

this.gfn_today = function()
{
  var date = new Date();
  var year = date.getFullYear();
  var month = ("0" + (date.getMonth() + 1)).slice(-2);
  var day = ("0" + date.getDate()).slice(-2);
  return "" + year + month + day;
};
